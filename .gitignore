node_modules/

# Keys. The build refuses to bundle anything key-shaped, but the cheapest
# place to stop a credential reaching a public repo is here.
.env
.env.*
*.pem
*.key

# Build output. `npm run build:static` copies these in from
# prototypes/meal-plan/web/public and compiles the bundle; CI publishes them.
# The hand-written pages beside them — index, plan, google-setup — are source.
docs/app/
docs/check-google.html
docs/check-google.css
docs/check-google.js
docs/check-logic.js
docs/vendor-supabase.js

# Editors and OS litter
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# Supabase project details for the published build. The anon key in here is
# public by design, but which project the demo points at is a deployment
# choice, so it is supplied at build time rather than committed.
supabase.config.json

# The household itself, as the local server keeps it between restarts. It is
# the family's own data — names, ages, allergies, calendars — and belongs on
# the machine that typed it in, not in a public repository.
.family-state.json
.family-state.json.*
