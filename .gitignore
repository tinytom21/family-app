node_modules/

# Keys. The build refuses to bundle anything key-shaped, but the cheapest
# place to stop a credential reaching a public repo is here.
.env
.env.*
*.pem
*.key

# Build output. docs/app is generated by `npm run build:static` and published
# by CI, so it is not committed.
docs/app/

# Editors and OS litter
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
